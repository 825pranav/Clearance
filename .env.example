DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clearance
LLM_PROVIDER=openai      # openai (any OpenAI-compatible endpoint) or anthropic (Claude via the Anthropic SDK)
LLM_BASE_URL=            # e.g. https://api.groq.com/openai/v1 (confirm in provider docs)
LLM_API_KEY=
LLM_MODEL=               # a current model that supports tool calling
ANTHROPIC_API_KEY=       # only for LLM_PROVIDER=anthropic or the Claude entries in evals/models.yaml
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_DRY_RUN=1         # 1 = fake client, no network. Tests and evals always use 1.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
DEMO_EMPLOYEE_EMAIL=     # fallback identity when a Slack user is not in the employees table
DJANGO_DEBUG=1           # 1 for local work only. With 0, DJANGO_SECRET_KEY and DJANGO_ALLOWED_HOSTS are required.
DJANGO_SECRET_KEY=       # generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_ALLOWED_HOSTS=    # comma-separated hostnames the console answers to
CONSOLE_DB_PASSWORD=     # password for the console's limited database login; letters and digits only
